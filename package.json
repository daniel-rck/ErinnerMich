{
  "name": "erinnermich",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "description": "Privacy-first PWA für Erinnerungen, Habits und Mood – lokal, ohne Account.",
  "keywords": [
    "pwa",
    "reminders",
    "habits",
    "mood-tracker",
    "offline",
    "privacy",
    "react",
    "vite",
    "typescript"
  ],
  "author": "Daniel Rück",
  "license": "MIT",
  "homepage": "https://erinnermich.daniel-rck.workers.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/daniel-rck/ErinnerMich.git"
  },
  "bugs": {
    "url": "https://github.com/daniel-rck/ErinnerMich/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.38.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@cloudflare/workers-types": "^4.20260504.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6",
    "@vitest/ui": "^4.1.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "vite": "^8",
    "vite-plugin-pwa": "^1.3",
    "vitest": "^4.1.5",
    "workbox-precaching": "^7.4.0",
    "wrangler": "^4.87.0"
  }
}
