{
  "name": "erinnermich",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "description": "Privacy-first PWA für Erinnerungen, Habits und Mood – lokal, ohne Account.",
  "keywords": [
    "pwa",
    "reminders",
    "habits",
    "mood-tracker",
    "offline",
    "privacy",
    "react",
    "vite",
    "typescript"
  ],
  "author": "Daniel Rück",
  "license": "MIT",
  "homepage": "https://erinnermich.daniel-rck.workers.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/daniel-rck/ErinnerMich.git"
  },
  "bugs": {
    "url": "https://github.com/daniel-rck/ErinnerMich/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && oxfmt --check",
    "format": "oxfmt",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^13.4.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^5.0.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-precaching": "^7.4.1",
    "wrangler": "^4.136.3"
  },
  "webBase": {
    "version": "0.5.0"
  }
}
